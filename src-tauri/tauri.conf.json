{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeepSeek Harness Launcher",
  "version": "0.2.0",
  "identifier": "io.github.hairyf.deepseek-harness-launcher",
  "build": {
    "beforeDevCommand": "echo no-frontend",
    "beforeBuildCommand": "echo no-frontend",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "shortDescription": "DeepSeek Harness 托盘启动器",
    "longDescription": "常驻任务栏的托盘程序，用于安装 / 启动 DeepSeek Harness 及全部依赖，并提供 npm 源 / GitHub 加速切换与可配置网址菜单。"
  },
  "plugins": {}
}
